{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tusker-web",
  "account_id": "9aa603db8b4ff3924b801a2c0f0c49fb",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "env": {
    "dev": {
      "preview_urls": true,
      "routes": [
        {
          "pattern": "tusker.codeuncode.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tusker-dev",
          "database_id": "f82d4a00-20bb-44ea-95c9-5f9453501781",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
