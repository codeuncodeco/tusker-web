// The ui-sandbox branch: static files and nothing else. No D1, no cron, no
// route and no Worker script, because the app runs in the browser. See
// `docs/sandbox.md`. This config never merges into `main`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tusker-web",
  "account_id": "9aa603db8b4ff3924b801a2c0f0c49fb",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "dev": {
      "preview_urls": true,
    },
  },
}
